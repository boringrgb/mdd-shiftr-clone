{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /srv
	encode zstd gzip

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle /mqtt* {
		reverse_proxy mosquitto:8083
	}

	handle /connections* {
		reverse_proxy backend:9999
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
